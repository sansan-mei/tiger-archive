# Image name is a proposed publishing target; build/push it before pulling on the server.
TANK_IMAGE=1596944197/tiger-archive:latest
HTTP_PORT=8080
BIND_ADDRESS=0.0.0.0
MAX_ROOMS=16
# Compress state packets over 1 KiB; set false only while diagnosing CPU pressure.
WS_COMPRESSION=true
# Actual game origin (scheme + domain + optional port), without a path.
# Leave empty for same-origin Host validation; do not copy another site's domain.
PUBLIC_ORIGIN=
# Existing Redis service on the same Docker network. No new Redis container is created.
# Authentication example: redis://default:URL_ENCODED_PASSWORD@redis:6379/0
# Explicitly empty REDIS_URL enables memory-only mode.
REDIS_URL=redis://redis:6379/0
# One server per prefix; separate unrelated deployments with unique prefixes.
REDIS_PREFIX=tiger:rooms:v14
# Required only with compose.redis-network.yaml (separate Compose projects).
REDIS_NETWORK=
# Used only by the optional compose.build.yaml image build.
OBFUSCATE_CLIENT=true
