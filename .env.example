HTTP_PORT=8080
BIND_ADDRESS=0.0.0.0
MAX_ROOMS=16
# Set to the actual public origin behind a reverse proxy, with no trailing path.
PUBLIC_ORIGIN=
# Optional. Empty means memory-only mode. Replace the example with your existing Redis.
# REDIS_URL='redis://default:URL_ENCODED_PASSWORD@host.docker.internal:6379/0'
REDIS_URL=
# Use a unique prefix for each independent deployment; one server per prefix.
REDIS_PREFIX=tiger:rooms:v13

# Docker build-time switch; false creates readable client assets for debugging.
OBFUSCATE_CLIENT=true
